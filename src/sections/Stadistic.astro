---
// Image asset constants
const img69991038D83Aec5C47879A00Jpg = "/images/sensei.webp";
const img6999103820C0350C1974FcecJpg = "/images/lord.webp";
const img699910389Df4C13330Afd153Jpg = "/images/anxo.webp";
const img6999114Ad83Aec475987B687Jpg = "/images/usa.webp";
const img69991038F8345319E89C5004Jpg = "/images/diego.webp";
const img69991038A2A2C0770B7Eea9CJpeg = "/images/sergio.webp";
const imgFrame = "/images/clock.svg";
const imgFrame1 = "/images/money.svg";
const imgVector = "/images/vector.svg";
const imgVector1 = "/images/vector-1.svg";
const imgFrame2 = "/images/frame-2.svg";
const imgFrame3 = "/images/frame3.svg";
const imgFrame4 = "/images/frame4.svg";
---
<section class="w-full flex justify-center items-center overflow-hidden relative">
  <img src="/images/fondo.webp" alt="Fondo de Imagen" width="1440" height="1442" class="w-full h-full absolute inset-0 object-[100%_50%] object-cover -z-10 masked-image" decoding="async" loading="lazy"/>
  <div class="flex flex-col justify-center items-center gap-10 md:gap-15 py-14 md:py-27.5 container-full">
    <div class="flex flex-col justify-center items-center gap-3">
      <p class="text-[9px] font-sergoe font-light tracking-[2.34px] uppercase text-[#F5F5F561] text-center">Sin publicidad de pago</p>
      <h2 class="text-[30.1px] md:text-[54px] lg:text-[68px] text-text leading-[108%] text-center font-normal">Consigue <span class="text-accent italic">clientes</span>
        <br/> con <span>redes sociales</span></h2>
      <p class="text-[12px] md:text-[14px] font-sergoe font-light text-[#F5F5F561] text-center tracking-[0.28px]">Sin invertir en anuncios</p>
    </div>
    <div class="gap-x-2 gap-y-2 grid grid-cols-1 md:grid-cols-3 relative w-full" data-node-id="1:285">
      <!-- CARD 1: +80% Margen -->
      <div class="bg-[#111] border border-[rgba(255,255,255,0.07)] col-span-1 flex flex-col items-start justify-between p-5 md:p-7 rounded-[6px] overflow-hidden min-h-[230px] hover:translate-y-[-5px] transition-transform duration-300 ease-in-out">
        <!-- Header -->
        <div class="w-full">
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-1.5 items-center">
              <img alt="" class="w-2.5 h-2.5" src={imgFrame} decoding="async" loading="lazy"/>
              <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[1.26px] uppercase font-light font-sergoe">Resultados sistema</p>
            </div>
            <div class="flex gap-1">
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
            </div>
          </div>

          <!-- Value -->
          <div class="flex flex-row md:flex-col lg:flex-row justify-start md:justify-center lg:justify-start  items-start lg:items-end gap-4 lg:gap-2.5 mb-3">
            <p class="text-[64px] text-[#F5F5F5] leading-[64px] tracking-[-1.28px]">+80%</p>
            <div class="bg-[rgba(201,168,76,0.15)] border border-[rgba(201,168,76,0.25)] px-2 py-1 rounded-[20px]">
              <p class="text-[10px] text-[#c9a84c] font-semibold tracking-[0.4px] font-sergoe">margen</p>
            </div>
          </div>

          <!-- Label -->
          <p class="text-[14px] text-[#F5F5F5] font-semibold mb-3 font-sergoe">Margen en los negocios</p>
        </div>

        <!-- Mini Metrics Grid -->
        <div class="w-full grid grid-cols-2 gap-1.5">
          <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] p-3 rounded-[4px]">
            <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[0.72px] uppercase font-light mb-1 font-sergoe">Seguidores</p>
            <div class="flex items-center gap-1.5">
              <p class="text-[20px] text-[#F5F5F5]">750K</p>
              <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] px-1.5 py-0.5 rounded-[10px]">
                <p class="text-[8px] text-[#4ade80]">↑13.1%</p>
              </div>
            </div>
          </div>
          <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] p-3 rounded-[4px]">
            <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[0.72px] uppercase font-light mb-1 font-sergoe">Conv. Rate</p>
            <div class="flex items-center gap-1.5">
              <p class="text-[20px] text-[#F5F5F5]">68.5%</p>
              <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] px-1.5 py-0.5 rounded-[10px]">
                <p class="text-[8px] text-[#4ade80]">↑30.9%</p>
              </div>
            </div>
          </div>
          <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] p-3 rounded-[4px]">
            <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[0.72px] uppercase font-light mb-1 font-sergoe">Impresiones</p>
            <div class="flex items-center gap-1.5">
              <p class="text-[20px]  text-[#F5F5F5]">5.7B</p>
              <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] px-1.5 py-0.5 rounded-[10px]">
                <p class="text-[8px] text-[#4ade80]">↑28.4%</p>
              </div>
            </div>
          </div>
          <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] p-3 rounded-[4px]">
            <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[0.72px] uppercase font-light mb-1 font-sergoe">Clientes</p>
            <div class="flex items-center gap-1.5">
              <p class="text-[20px] text-[#F5F5F5]">1.5M</p>
              <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] px-1.5 py-0.5 rounded-[10px]">
                <p class="text-[8px] text-[#4ade80]">↑25.8%</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 2: +32M€ Revenue Sparkline -->
      <div class="bg-[#111] border border-[rgba(255,255,255,0.07)] col-span-1 flex flex-col items-start justify-between p-4 md:p-7 rounded-[6px] overflow-hidden min-h-[230px] hover:translate-y-[-5px] transition-transform duration-300 ease-in-out">
        <!-- Header -->
        <div class="w-full">
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-1.5 items-center">
              <img alt="Icono" class="w-2.5 h-2.5" src={imgFrame1} decoding="async" loading="lazy"/>
              <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[1.26px] uppercase font-light font-sergoe">Ingresos totales</p>
            </div>
            <div class="flex gap-1">
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
            </div>
          </div>

          <!-- Value -->
          <div class="flex flex-row md:flex-col lg:flex-row justify-start md:justify-center lg:justify-start items-start lg:items-end gap-4 lg:gap-2.5 mb-3">
            <p class="text-[52px] text-[#F5F5F5] leading-[52px] tracking-[-1.04px]">+32M€</p>
            <div class="bg-[rgba(201,168,76,0.15)] border border-[rgba(201,168,76,0.25)] px-2 py-1 rounded-[20px]">
              <p class="text-[10px] text-[#c9a84c] font-semibold tracking-[0.4px] font-sergoe">récord</p>
            </div>
          </div>
        </div>

        <!-- Sparkline Chart -->
        <div class="w-full">
          <!-- Month Labels -->
          <div class="flex justify-between items-start gap-1 mb-3 ">
            <p class="text-[8px] text-[rgba(245,245,245,0.38)] uppercase tracking-[0.8px] font-sergoe">Ene</p>
            <p class="text-[8px] text-[rgba(245,245,245,0.38)] uppercase tracking-[0.8px] font-sergoe">Abr</p>
            <p class="text-[8px] text-[rgba(245,245,245,0.38)] uppercase tracking-[0.8px] font-sergoe">Jul</p>
            <p class="text-[8px] text-[rgba(245,245,245,0.38)] uppercase tracking-[0.8px] font-sergoe">Oct</p>
            <p class="text-[8px] text-[#c9a84c] uppercase tracking-[0.8px] font-sergoe">▲ +340%</p>
          </div>

          <!-- Chart -->
          <div class="w-full h-[52px] overflow-hidden relative">
            <div class="absolute inset-[1.92%_0_7.69%_0]">
              <img alt="Sparkline Chart" class="block max-w-none w-full h-full" src={imgVector} decoding="async" loading="lazy"/>
            </div>
            <div class="absolute inset-[1.92%_0_0_0]">
              <img alt="Sparkline Chart" class="block max-w-none w-full h-full" src={imgVector1} decoding="async" loading="lazy"/>
            </div>
          </div>
        </div>

        <!-- Label & Description -->
        <div class="w-full ">
          <p class="text-[14px] text-[#F5F5F5] font-semibold mb-1 font-sergoe">Generados en ventas</p>
          <p class="text-[11px] text-[rgba(245,245,245,0.38)] font-light font-sergoe">Euros acumulados con este sistema</p>
        </div>
      </div>

      <!-- CARD 3: +100M Instagram (Tall Card) -->
      <div class="bg-[#111] border border-[rgba(255,255,255,0.07)] col-span-1 row-span-2 flex flex-col items-start justify-between p-4 md:p-7 rounded-[6px] overflow-hidden relative hover:translate-y-[-5px] transition-transform duration-300 ease-in-out">
        <!-- Header -->
        <div class="w-full">
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-1.5 items-center">
              <img alt="Icono" class="w-2.5 h-2.5" src={imgFrame2} decoding="async" loading="lazy"/>
              <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[1.26px] uppercase font-light font-sergoe">Seguidores Instagram</p>
            </div>
            <div class="flex gap-1">
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
            </div>
          </div>

          <!-- Instagram Badge -->
          <div class="flex gap-3.5 items-center mb-4">
            <div class="flex items-center justify-center w-[52px] h-[52px] rounded-[14px] drop-shadow-[0px_8px_12px_rgba(253,29,29,0.2)]" style="background: linear-gradient(135deg, rgb(131, 58, 180) 0%, rgb(253, 29, 29) 50%, rgb(252, 176, 69) 100%)">
              <img alt="Instagram Icon" class="w-[26px] h-[26px]" src={imgFrame3} decoding="async" loading="lazy"/>
            </div>
            <div>
              <p class="text-[10px] text-[rgba(245,245,245,0.38)] tracking-[1.2px] uppercase font-light font-sergoe">Instagram</p>
              <p class="text-[11px] text-[rgba(245,245,245,0.5)] font-light font-sergoe">Seguidores orgánicos</p>
            </div>
          </div>

          <!-- Value -->
          <p class="text-[54px] lg:text-[68px]  text-[#F5F5F5] leading-[68px] tracking-[-1.36px] mb-4">+100M</p>

          <!-- Badge -->
          <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] flex items-center gap-1 px-2 py-1 rounded-[20px] mb-4 w-full">
            <p class="text-[9px] text-[#4ade80] font-semibold tracking-[0.4px] font-sergoe">↑</p>
            <p class="text-[10px] text-[#4ade80] font-semibold tracking-[0.4px] font-sergoe">100% orgánico · sin ads</p>
          </div>
        </div>

        <!-- Growth Stats -->
        <div class="w-full flex flex-col gap-1.5">
          <div class="flex items-start justify-between mb-2.5">
            <p class="text-[9px] text-[rgba(245,245,245,0.38)] uppercase tracking-[0.72px] font-light font-sergoe">Crecimiento acumulado</p>
            <p class="text-[9px] text-[#c9a84c] uppercase tracking-[0.72px] font-light font-sergoe">▲ récord</p>
          </div>

          <div class="bg-[rgba(255,255,255,0.07)] h-[3px] rounded-[2px]">
            <div class="bg-gradient-to-r from-[rgba(253,29,29,0.5)] to-[#fcb045] h-full rounded-[2px] w-[92%]" />
          </div>

          <div class="flex flex-col gap-1.75 pt-2.5">
            <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] flex items-center justify-between px-3 py-2.25 rounded-[4px]">
              <p class="text-[10px] text-[rgba(245,245,245,0.38)] font-light font-sergoe">Seguidores totales</p>
              <p class="text-[16px]  text-[#F5F5F5]">100M+</p>
            </div>
            <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] flex items-center justify-between px-3 py-2.25 rounded-[4px]">
              <p class="text-[10px] text-[rgba(245,245,245,0.38)] font-light font-sergoe">Inversión en ads</p>
              <p class="text-[13px] font-semibold text-[#4ade80]">0€</p>
            </div>
            <div class="bg-[#161616] border border-[rgba(255,255,255,0.07)] flex items-center justify-between px-3 py-2.25 rounded-[4px]">
              <p class="text-[10px] text-[rgba(245,245,245,0.38)] font-light font-sergoe">Clientes desde IG</p>
              <p class="text-[16px]  text-[#F5F5F5]">+5.000</p>
            </div>
          </div>
        </div>

        <!-- Top border accent -->
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-[rgba(201,168,76,0)] via-[#c9a84c] to-[rgba(201,168,76,0)] opacity-60" />
      </div>

      <!-- CARD 4: +100 Clientes collage -->
      <div class="bg-[#111] border border-[rgba(255,255,255,0.07)] col-span-1 flex flex-col items-start justify-between p-4 md:p-7 rounded-[6px] overflow-hidden min-h-[230px] relative hover:translate-y-[-5px] transition-transform duration-300 ease-in-out">
        <!-- Background Images with overlay -->
        <div class="absolute inset-0 w-full h-full">
          <div class="gap-0.5 grid grid-cols-3 grid-rows-2 w-full h-full">
            <div class="relative overflow-hidden" >
              <img alt="Imagen 1" class="absolute w-full h-full inset-0 object-cover top-0" src={img69991038D83Aec5C47879A00Jpg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
            <div class="relative overflow-hidden" >
              <img alt="Imagen 2" class="absolute w-full h-full inset-0 object-cover top-0" src={img6999103820C0350C1974FcecJpg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
            <div class="relative overflow-hidden" >
              <img alt="Imagen 3" class="absolute w-full h-full inset-0 object-cover top-0" src={img699910389Df4C13330Afd153Jpg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
            <div class="relative overflow-hidden" >
              <img alt="Imagen 4" class="absolute w-full h-full inset-0 object-cover top-0" src={img6999114Ad83Aec475987B687Jpg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
            <div class="relative overflow-hidden" >
              <img alt="Imagen 5" class="absolute w-full h-full inset-0 object-cover top-0" src={img69991038F8345319E89C5004Jpg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
            <div class="relative overflow-hidden" >
              <img alt="Imagen 6" class="absolute w-full h-full inset-0 object-cover top-0" src={img69991038A2A2C0770B7Eea9CJpeg} decoding="async" loading="lazy" width="112" height="133" />
              <div class="absolute inset-0 bg-white mix-blend-saturation" />
            </div>
          </div>
        </div>

        <!-- Gradient overlay -->
        <div class="absolute inset-0" style="background: linear-gradient(160.01304636696494deg, rgba(17, 17, 17, 0.82) 0%, rgba(17, 17, 17, 0.65) 50%, rgba(17, 17, 17, 0.88) 100%)" />

        <!-- Content -->
        <div class="relative w-full z-10">
          <!-- Header -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-1.5 items-center">
              <img alt="Icono" class="w-2.5 h-2.5" src={imgFrame4} decoding="async" loading="lazy"/>
              <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[1.26px] uppercase font-light font-sergoe">Crecimiento verificado</p>
            </div>
            <div class="flex gap-1">
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
              <div class="bg-[rgba(255,255,255,0.15)] rounded-[2px] w-1 h-1" />
            </div>
          </div>

          <!-- Value and Badge -->
          <div class="flex items-end gap-2.5 mb-3">
            <p class="text-[52px] text-[#F5F5F5] leading-[52px] tracking-[-1.04px]">+100</p>
            <div class="bg-[rgba(74,222,128,0.12)] border border-[rgba(74,222,128,0.2)] flex items-center gap-1 px-2 py-1 rounded-[20px]">
              <p class="text-[9px] text-[#4ade80] font-semibold tracking-[0.4px] font-sergoe">↑</p>
              <p class="text-[10px] text-[#4ade80] font-semibold tracking-[0.4px] font-sergoe">casos</p>
            </div>
          </div>

          <!-- Bar chart -->
          <div class="flex flex-col gap-0.75 mb-3">
            <div class="flex gap-1.25 h-14 items-end justify-center">
              <div class="bg-[rgba(201,168,76,0.2)] w-[31.2px] h-[14px] rounded-t-[2px]" />
              <div class="bg-[rgba(201,168,76,0.2)] w-[31.22px] h-[19.59px] rounded-t-[2px]" />
              <div class="bg-[rgba(201,168,76,0.2)] w-[31.2px] h-[23.52px] rounded-t-[2px]" />
              <div class="bg-[rgba(201,168,76,0.2)] w-[31.22px] h-[30.8px] rounded-t-[2px]" />
              <div class="bg-[rgba(201,168,76,0.2)] w-[31.2px] h-[33.59px] rounded-t-[2px]" />
              <div class="bg-gradient-to-t from-[rgba(201,168,76,0.7)] to-[#c9a84c] w-[31.2px] h-[42px] rounded-t-[2px]" />
              <div class="bg-gradient-to-t from-[rgba(201,168,76,0.7)] to-[#c9a84c] w-[31.2px] h-[49.27px] rounded-t-[2px]" />
              <div class="bg-gradient-to-t from-[rgba(201,168,76,0.7)] to-[#c9a84c] w-[31.2px] h-full rounded-t-[2px]" />
            </div>

            <!-- Labels -->
            <div class="flex gap-1.25 justify-center">
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q1</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.22px] font-sergoe">Q2</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q3</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.22px] font-sergoe">Q4</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q1</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q2</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q3</p>
              <p class="text-[7px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.28px] uppercase font-light w-[31.2px] font-sergoe">Q4</p>
            </div>
          </div>

          <!-- Description -->
          <p class="text-[14px] text-[#F5F5F5] font-semibold mb-1 font-sergoe leading-[140%]">Clientes con más de 100K seguidores</p>
          <p class="text-[11px] text-[rgba(245,245,245,0.38)] font-light font-sergoe leading-[160%]">Casos verificados de crecimiento masivo</p>
        </div>
