        <!-- Header -->
        <div class="w-full">
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-1.5 items-center">
              <img alt="Icono" class="w-2.5 h-2.5" src={imgFrame1} decoding="async" loading="lazy"/>
              <p class="text-[9px] text-[rgba(245,245,245,0.38)] tracking-[1.26px] uppercase font-light font-sergoe">Meta del sistema</p>
