<section class="bg-[#060606] flex flex-col justify-center items-center w-full ">
  <div class="container-full flex flex-col justify-center items-center py-22 border-y border-white/5 gap-10">
    <div class="flex flex-col justify-center items-center gap-4.5">
      <p class="text-[#F5F5F5]/38 text-[9px] font-sergoe font-light leading-[100%] tracking-[2.34px] uppercase">Nuestra red</p>
      <h2 class="text-[54px] lg:text-[68px] font-normal italic text-center tracking-[-0.68] leading-[100%] text-accent">Comunidad <span class="text-text">Viralidad</span></h2>
    </div>
    <div class="hidden lg:grid grid-cols-1 md:grid-cols-3 justify-center items-center gap-2.5 w-full">
      {
        Array.from({length: 6}, (_, i)=>( 
          <div class="flex jusitfy-start items-end w-full h-auto rounded-[10px] border border-white/5 relative group overflow-hidden px-[14px] pb-[19px] comu-back cursor-pointer hover:scale-y-103 transition-transform duration-300 ease-in-out" style="aspect-ratio: 300 / 402;">
            <img src={`/images/comunidad-${i+1}.webp`} alt={`Comunidad ${i+1}`} class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-70 z-0 transition-all duration-300 ease-in-out group-hover:scale-105" width="300" height="402" />
            <div class="flex flex-col justify-center items-start gap-1 z-10">
              <p class="text-white/50 text-[8px] font-sergoe font-light leading-[100%] tracking-[1.76px] uppercase">Comunidad</p>
              <h3 class="text-[#F5F5F5] text-[19px] font-normal leading-[115%] tracking-[0.19px]">Viralidad</h3>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Carousel para md hacia abajo -->
    <div class="flex md:flex flex-col justify-center items-center gap-4 w-full lg:hidden">
      <div class="carousel-comunidad-container w-full relative overflow-hidden" style="padding: 0;">
        <style>
          .carousel-comunidad-track {
            display: flex;
            gap: 12px;
            width: 100%;
            transition: none;
            padding: 0 20px; /* ← menos peek */
            box-sizing: border-box;
          }
          .carousel-comunidad-slide {
            flex: 0 0 calc(100% - 40px); /* ← consistente con padding */
            display: flex;
            justify-content: center;
          }
          .carousel-comunidad-container {
            overflow: visible;
          }
        </style>
        <div class="carousel-comunidad-track">
          {
            Array.from({length: 6}, (_, i)=>( 
              <div class="carousel-comunidad-slide">
                <div class="flex jusitfy-start items-end w-full h-auto rounded-[10px] border border-white/5 relative group overflow-hidden px-[14px] pb-[19px] comu-back cursor-pointer hover:scale-y-103 transition-transform duration-300 ease-in-out" style="aspect-ratio: 300 / 402;">
                  <img src={`/images/comunidad-${i+1}.webp`} alt={`Comunidad ${i+1}`} class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-70 z-0 transition-all duration-300 ease-in-out group-hover:scale-105" width="300" height="402" />
                  <div class="flex flex-col justify-center items-start gap-1 z-10">
                    <p class="text-white/50 text-[8px] font-sergoe font-light leading-[100%] tracking-[1.76px] uppercase">Comunidad</p>
                    <h3 class="text-[#F5F5F5] text-[19px] font-normal leading-[115%] tracking-[0.19px]">Viralidad</h3>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Indicadores -->
      <div class="carousel-comunidad-indicators flex justify-center items-center gap-2">
        {
          Array.from({length: 6}, (_, i) => (
            <button 
              class="carousel-comunidad-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300 cursor-pointer hover:bg-white/60" 
              data-slide={i}
              aria-label={`Go to slide ${i + 1}`}
            />
          ))
        }
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('.carousel-comunidad-container') as HTMLElement;
  const track = document.querySelector('.carousel-comunidad-track') as HTMLElement;
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.carousel-comunidad-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-comunidad-dot'));

  if (!container || !track || slides.length === 0) return;

  let currentSlide = 0;
  let isAnimating = false;
  let isDragging = false;
  let startX = 0;
  let dragStartOffset = 0; // offset al inicio del drag (fijo durante el drag)
  let currentOffset = 0;   // offset actual aplicado al track
  const gap = 12;

  function getSlideWidth() {
    return slides[0].getBoundingClientRect().width;
  }

  function getTargetOffset(index: number) {
    const sw = getSlideWidth();
    if (index === 0) return 0;
    return (sw + gap) * index - gap; // ← resta el gap para compensar
  }

  function updateDots() {
    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.add('!bg-white', '!w-6');
        dot.classList.remove('bg-white/30');
      } else {
        dot.classList.remove('!bg-white', '!w-6');
        dot.classList.add('bg-white/30');
      }
    });
  }

  function snapToSlide(index: number, duration = 400) {
    const target = getTargetOffset(index);
    isAnimating = true;

    const anim = track.animate([
      { transform: `translateX(-${currentOffset}px)` },
      { transform: `translateX(-${target}px)` }
    ], {
      duration,
      easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
      fill: 'forwards'
    });

    anim.onfinish = () => {
      currentOffset = target;
      track.style.transform = `translateX(-${currentOffset}px)`;
      anim.cancel();
      isAnimating = false;
    };
  }

  function goToSlide(index: number) {
    if (isAnimating) return;
    if (index < 0 || index >= slides.length) return;
    currentSlide = index;
    updateDots();
    snapToSlide(currentSlide);
  }

  // ─── Drag / Touch ────────────────────────────────────────────

  function onDragStart(x: number) {
    if (isAnimating) return;
    isDragging = true;
    startX = x;
    dragStartOffset = currentOffset; // captura el offset real al inicio
  }

  function onDragMove(x: number) {
    if (!isDragging) return;
    const diff = startX - x;
    currentOffset = dragStartOffset + diff;
    track.style.transform = `translateX(-${currentOffset}px)`;
  }

  function onDragEnd(x: number) {
    if (!isDragging) return;
    isDragging = false;

    const diff = startX - x;
    const threshold = getSlideWidth() * 0.2; // 20% del slide para cambiar

    let nextSlide = currentSlide;
    if (diff > threshold) {
      nextSlide = Math.min(currentSlide + 1, slides.length - 1);
    } else if (diff < -threshold) {
      nextSlide = Math.max(currentSlide - 1, 0);
    }

    currentSlide = nextSlide;
    updateDots();
    snapToSlide(currentSlide, 350);
  }

  // Mouse
  container.addEventListener('mousedown', (e: MouseEvent) => onDragStart(e.clientX));
  document.addEventListener('mousemove', (e: MouseEvent) => { if (isDragging) onDragMove(e.clientX); });
  document.addEventListener('mouseup', (e: MouseEvent) => { if (isDragging) onDragEnd(e.clientX); });

  // Touch
  container.addEventListener('touchstart', (e: TouchEvent) => onDragStart(e.touches[0].clientX), { passive: true });
  document.addEventListener('touchmove', (e: TouchEvent) => { if (isDragging) onDragMove(e.touches[0].clientX); }, { passive: true });
  document.addEventListener('touchend', (e: TouchEvent) => { if (isDragging) onDragEnd(e.changedTouches[0].clientX); });

  // Dots
  dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));

  // Init
  updateDots();
  track.style.transform = 'translateX(0px)';

  window.addEventListener('resize', () => {
    if (!isDragging && !isAnimating) {
      currentOffset = getTargetOffset(currentSlide);
      track.style.transform = `translateX(-${currentOffset}px)`;
    }
  });
});
      </script>
    </div>
  </div>
</section>