---
interface CreatorProfile {
  name: string;
  image: string;
}

const creators: CreatorProfile[] = [
  { name: "Christian <br/> Villar", image: 'christian' },
  { name: "El Lobo de <br/> Wall Street", image:'lobo' },
  { name: "Sensei", image: 'sensei' },
  { name: "Anxo <br/> Pérez", image: 'anxo' },
  { name: "Lord <br/> Ramon", image: 'lord' },
  { name: "Alfredo <br/> Marín", image: 'alfredo' },
  { name: "Diego <br/> García", image: 'diego' },
  { name: "Franklin <br/>Ovalles", image: 'franklin' },
];
---
<section class="w-full flex flex-col justify-center items-center relative overflow-hidden gap-[46px]">
  <div class="w-full flex flex-col justify-center items-center relative">
    <img src="/images/fondo.webp" alt="Fondo de Imagen" width="1440" height="1442" class="w-full h-full absolute inset-0 object-[100%_50%] object-cover -z-10 masked-image" />
    <div class="container-full flex flex-col justify-center items-center">
      <div class="flex items-center justify-center h-[85px] pt-[10px] px-[5px] w-full shrink-0">
        <div class="h-[41px] w-[152px] overflow-hidden">
          <img
            alt="Viralidad Logo"
            class="h-full w-full object-cover"
            src="/images/logo.webp"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="flex flex-col gap-[25px] items-center justify-center pt-[53px] md:py-[53px] px-0 md:px-4 ">
          <!-- Headline -->
          <div class="flex flex-col gap-2 md:gap-[11px] items-center text-center w-full animation-up-fast-2">
            <div class="paragraph text-text">
              <p>
                El <span class="text-accent">método</span> <span
                  class="text-accent italic">viral</span
                > que utilizan
              </p>
            </div>
            <div class="paragraph text-accent">
              <p>
                <span>gurús</span><span class="text-text"> e </span
                ><span>influencers</span><span class="text-text"
                  > de </span
                ><span>redes sociales</span><span class="text-text"
                  > para ganar</span
                >
              </p>
            </div>
            <div class="text-[38px] md:text-[44px] text-accent tracking-[-1.1px] leading-[120%]">
              <p>
                <span>100.000 Seguidores</span> <br class="block md:hidden"/>
                <span class="text-text"> y </span>
                <span class="italic text-text"
                  >+20.000€ / mes</span
                >
              </p>
            </div>
            <div class="italic text-[14px] md:text-[20px] text-text tracking-[0.2px]">
              <p>(en menos de 90 días)</p>
            </div>
          </div>

          <!-- Divider -->
          <div class="bg-[rgba(255,255,255,0.12)] h-px w-[140px]"></div>

          <!-- Cover Image -->
          <div class="relative w-full h-auto md:h-[370px] md:w-[658px] max-w-full overflow-hidden rounded-lg">
            <img
              alt="Viralidad Cover"
              class="h-full w-full object-cover"
              src="/images/hero-image.webp"
              loading="eager"
              decoding="async"
            />
          </div>
      </div>
      <div class="flex flex-col gap-[23px] items-center justify-center py-[22px] px-4 w-full">
        <!-- Main Button -->
        <a
          class="button-gradient flex items-center justify-center md:px-[48px] py-[18px] rounded-[14px] shrink-0 w-full md:w-auto" href="https://victorherass.typeform.com/to/LNLqGsYp"
        >
          <span
            class="font-title font-semibold text-[13px] md:text-[16px] text-[#0a0a0a] tracking-[1.44px] uppercase"
          >
            Agendar mi reunión de admisión
          </span>
        </a>

        <!-- Trustpilot Rating Bar -->
        <div
          class="bg-[#141209] border border-[rgba(201,168,76,0.15)] flex gap-[12px] items-center px-[21px] py-[11px] rounded-[100px] w-auto"
        >
          <!-- Stars -->
          <div class="flex gap-[3px]">
            {
              Array(5)
                .fill(0)
                .map(() => (
                  <div class="bg-[#00b67a] flex items-center justify-center rounded-[2px] size-[18px]">
                    <img
                      alt="Star"
                      class="size-[11px]"
                      src='/images/star.svg'
                    />
                  </div>
                ))
            }
          </div>
          <!-- Rating -->
          <span class="font-times font-bold text-[12.5px] text-[#f0ead6] whitespace-nowrap"
            >4.8 · Excellent</span
          >
          <!-- Separator -->
          <div class="bg-[rgba(201,168,76,0.15)] h-[14px] w-px"></div>
          <!-- Link -->
          <a
            href="https://www.trustpilot.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-times  text-[10.9px] text-[#00b67a] tracking-[0.326px] hover:underline whitespace-nowrap"
          >
            Ver en Trustpilot ↗
          </a>
        </div>
      </div>
      <!-- Creators Section -->
      <div class="flex flex-col gap-[38px] items-center py-[12px] md:px-4 w-full">
        <div class="font-sergoe font-light text-[10px] text-[rgba(245,245,245,0.38)] text-center tracking-[2px] uppercase">
          Utilizado por los mayores <br class="block md:hidden"/> creadores de habla hispana
        </div>

        <div class="grid grid-cols-4 md:flex md:gap-[68px] items-start justify-center pb-4 w-full">
          {
            creators.map((creator) => (
              <div class="flex flex-col gap-[6.5px] items-center shrink-0">
                <div class="group hover:translate-y-[-3px] transition-transform duration-300 hover:scale-105">
                  <div class="bg-[#0c0c0c] border border-[rgba(255,255,255,0.07)] rounded-[28px] size-[56px] overflow-hidden relative ">
                    <div class="absolute inset-0 bg-black/30 group-hover:bg-black/0"></div>
                    <img
                      alt={creator.name}
                      class="h-full w-full object-cover"
                      src={`/images/${creator.image}.webp`}
                    />
                  </div>
                </div>
                
                <div class=" text-[9px] text-[rgba(245,245,245,0.38)] text-center tracking-[0.54px] uppercase max-w-[72px]">
                  <p  class="leading-[12.6px] m-0 font-sergoe font-light" set:html={creator.name}>
                      
                    </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Success Cases Section -->
      <div class="flex items-center justify-center py-3 md:py-[40px] md:px-4 w-full mb-2">
        <div class="text-[20px] md:text-[32px] text-[#f5f5f5] font-normal">
          <p>
            <span>+5.000</span>
            <span class="text-[20px] md:text-[32px] italic text-[rgba(245,245,245,0.6)] font-normal"> Casos de éxito</span>
          </p>
        </div>
      </div>
      <div class="flex items-center justify-center py-[60px] px-4 w-full border-t border-b border-[rgba(255,255,255,0.07)]">
        <div class="flex md:gap-[137px] items-center justify-between md:justify-center overflow-x-auto">
          <div class="w-[20%] md:h-[68px] md:w-[84px] shrink-0">
            <img alt="Brand 1" class="h-full w-full object-contain" src='/images/univision.svg' />
          </div>
          <div class="w-[20%] md:h-[34px] md:w-[140px] shrink-0">
            <img alt="Brand 2" class="h-full w-full object-contain" src='/images/forbes.svg' />
          </div>
          <div class="w-[40%] md:h-[16.88px] md:w-[160px] shrink-0">
            <img alt="Brand 3" class="h-full w-full object-contain" src='/images/vanguardia.svg' />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>