              <div class="flex flex-col justify-center items-start gap-3 bg-[#111111] rounded-xs border border-white/5 p-4.5 w-full hover:scale-101 transition-all duration-300">
                <img src={`/images/${influencer.image}.webp`} alt={influencer.name} class="w-[34px] h-[34px] rounded-full grayscale-100" width="64" height="64" loading="lazy" decoding="async"/>
                <div class="flex flex-col justify-center items-start gap-1">
                  <h3 class="font-sergoe text-[12px] text-[#F5F5F5] tracking-[0.12px] font-semibold">{influencer.name}</h3>
                  <p class="text-[9px] font-sergoe font-light tracking-[0.54px] text-[#F5F5F561]">{influencer.label}</p>
                </div>
                <div class="flex flex-col justify-center items-start gap-1">
                  <div class="flex justify-start items-center gap-[7px]">
                    <p class="text-[22px] font-normal leading-[100%] text-[#F5F5F5]">{influencer.mount}</p>
                    <div class="flex justify-center items-center py-0.5 px-[7px] border border-[#C9A84C4D] rounded-[2px]">
                      <p class="text-[8px] font-semibold font-sergoe tracking-[1.12px] leading-[100%] text-[#C9A84C]">/ MES</p>
                    </div>
