                  <p class='text-[9px] font-sergoe font-light tracking-[0.54px] text-[#F5F5F561]'>{influencer.description}</p>
                </div>
                <img src={`/images/${influencer.img}.svg`} alt={`Bar for ${influencer.name}`} class="w-full h-auto" width="189" height="2" loading="lazy" decoding="async"/>
              </div>
            ))}
          </div>
          <!-- Group B (duplicate 3 items for infinite loop) -->
