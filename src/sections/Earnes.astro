      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const carousels = document.querySelectorAll('.carousel-vertical');
        
        carousels.forEach((carouselElement) => {
          const carouselContainer = carouselElement as HTMLElement;
          const track = carouselContainer.querySelector('.carousel-track-vertical') as HTMLElement;
          if (!track) return;
          
          const slides = Array.from(
            track.querySelectorAll<HTMLElement>('.carousel-slide-vertical')
          );
          
          if (slides.length < 2) return;

          let anim: Animation | null = null;
          const speedPxPerSec = 15;
          const direction = carouselContainer.getAttribute('data-direction') || 'forward';

          function startAnim() {
            if (anim) anim.cancel();
            
            const first = slides[0];
            const slideRect = first.getBoundingClientRect();
            const slideHeight = Math.round(slideRect.height);
            
            if (!slideHeight) return;
            
            // Establecer la altura del contenedor carousel igual a la altura de un slide
            carouselContainer.style.height = slideHeight + 'px';
            
            const trackStyle = getComputedStyle(track);
            const gap = parseFloat(trackStyle.gap || '0') || 0;
            const distance = slideHeight + gap;

            const duration = Math.max(3000, (distance / speedPxPerSec) * 1000);

            if (direction === 'backward') {
              anim = track.animate(
                [
                  { transform: `translateY(-${distance}px)` },
                  { transform: 'translateY(0px)' },
                ],
                { duration, iterations: Infinity, easing: 'linear' }
              );
            } else {
              anim = track.animate(
                [
                  { transform: 'translateY(0px)' },
                  { transform: `translateY(-${distance}px)` },
                ],
                { duration, iterations: Infinity, easing: 'linear' }
              );
            }

            // Pausa/reproduce al pasar mouse
            if (carouselContainer.dataset.carouselHoverBound !== '1') {
              carouselContainer.addEventListener('mouseenter', () => anim?.pause());
              carouselContainer.addEventListener('mouseleave', () => anim?.play());
              carouselContainer.dataset.carouselHoverBound = '1';
            }
          }

          startAnim();
          
          // Re-inicializa la animación al cambiar tamaño de ventana
          window.addEventListener('resize', () => {
            if (anim) anim.cancel();
            
            const newSlides = Array.from(
              track.querySelectorAll<HTMLElement>('.carousel-slide-vertical')
            );
            
            if (newSlides.length >= 2) {
              startAnim();
            }
          });
        });
      });
    </script>
  </div>
</section> 